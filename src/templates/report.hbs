<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8" />
<title>AI開発プロセス診断レポート</title>
<style>
  :root { color-scheme: light; }
  body { font-family: -apple-system, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif; max-width: 960px; margin: 0 auto; padding: 32px 24px 80px; background: #f7f8fa; color: #1f2328; }
  h1 { font-size: 1.6rem; }
  h2 { font-size: 1.25rem; margin-top: 2.2rem; border-bottom: 2px solid #e1e4e8; padding-bottom: 6px; }
  h3 { font-size: 1.05rem; margin-top: 1.4rem; }
  .meta { color: #57606a; font-size: 0.9rem; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
  .badge.light { background: #ddf4ff; color: #0969da; }
  .badge.detailed { background: #fff1e5; color: #bc4c00; }
  .score-overall { font-size: 2.4rem; font-weight: 700; }
  .score-card { background: #fff; border: 1px solid #e1e4e8; border-radius: 10px; padding: 16px 20px; margin-bottom: 14px; }
  .score-card .score-bar-track { background: #eaeef2; border-radius: 6px; height: 10px; overflow: hidden; margin: 8px 0 12px; }
  .score-card .score-bar-fill { height: 100%; border-radius: 6px; }
  .score-good .score-bar-fill { background: #2da44e; }
  .score-mid .score-bar-fill { background: #bf8700; }
  .score-bad .score-bar-fill { background: #cf222e; }
  .score-num { font-weight: 700; }
  ul { padding-left: 1.3rem; }
  li { margin-bottom: 4px; }
  table { border-collapse: collapse; width: 100%; margin-top: 8px; font-size: 0.88rem; }
  th, td { border: 1px solid #e1e4e8; padding: 6px 10px; text-align: left; }
  th { background: #f6f8fa; }
  .section { background: #fff; border: 1px solid #e1e4e8; border-radius: 10px; padding: 18px 22px; margin-top: 14px; }
  .label-reason { color: #cf222e; font-weight: 600; }
  .label-improve { color: #1a7f37; font-weight: 600; }
  code { background: #f6f8fa; padding: 1px 5px; border-radius: 4px; }
</style>
</head>
<body>
  <h1>AI開発プロセス診断レポート <span class="badge {{mode}}">{{modeLabel}}</span></h1>
  <p class="meta">生成日時: {{generatedAt}} ／ 比較基準: <code>{{baseRef}}</code></p>

  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">変更概要</h2>
    <p>{{summary}}</p>
  </div>

  {{#if isLight}}
  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">詳細分析をスキップした理由</h2>
    <ul>
      {{#each sizeJudgement.reasons}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{else}}
  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">詳細レポートと判定した理由</h2>
    <ul>
      {{#each sizeJudgement.reasons}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  {{#if overall}}
  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">総合AI開発準備スコア</h2>
    <div class="score-overall">{{overall.score}} <span style="font-size:1rem;color:#57606a;">/ 100</span></div>
  </div>

  <h2>カテゴリ別スコア</h2>
  {{#each overall.categories}}
  <div class="score-card {{scoreClass this.score}}">
    <h3 style="margin-top:0;">{{this.label}} — <span class="score-num">{{this.score}}</span> / 100</h3>
    <div class="score-bar-track"><div class="score-bar-fill" style="width: {{this.score}}%;"></div></div>
    {{#if this.deductionReasons.length}}
    <p class="label-reason">減点理由</p>
    <ul>{{#each this.deductionReasons}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}
    {{#if this.improvements.length}}
    <p class="label-improve">改善案</p>
    <ul>{{#each this.improvements}}<li>{{this}}</li>{{/each}}</ul>
    {{/if}}
  </div>
  {{/each}}
  {{/if}}

  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">テスト有無</h2>
    <p>{{#if testPresence.hasTestFiles}}テストファイルの変更あり ({{testPresence.testFileCount}}件){{else}}テストファイルの変更なし{{/if}}</p>
  </div>

  {{#unless isLight}}
  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">次回必要なドキュメント</h2>
    {{#if nextDocsNeeded.length}}
    <ul>{{#each nextDocsNeeded}}<li>{{this.reason}}</li>{{/each}}</ul>
    {{else}}
    <p>なし(必要なドキュメントは揃っています)</p>
    {{/if}}
  </div>

  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">AIに任せる前に足りなかった情報</h2>
    {{#if missingInfoBeforeAi.length}}
    <ul>{{#each missingInfoBeforeAi}}<li>{{this}}</li>{{/each}}</ul>
    {{else}}
    <p>なし</p>
    {{/if}}
  </div>
  {{/unless}}

  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">人間が確認すべきポイント</h2>
    <ul>{{#each humanCheckpoints}}<li>{{this}}</li>{{/each}}</ul>
  </div>

  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">リスク</h2>
    <ul>{{#each riskNotes}}<li>{{this}}</li>{{/each}}</ul>
  </div>

  {{#unless isLight}}
  <div class="section">
    <h2 style="margin-top:0;border:0;padding:0;">変更ファイル一覧</h2>
    <table>
      <thead><tr><th>ファイル</th><th>状態</th><th>追加</th><th>削除</th></tr></thead>
      <tbody>
        {{#each diff.files}}
        <tr><td>{{this.path}}</td><td>{{this.status}}</td><td>+{{this.insertions}}</td><td>-{{this.deletions}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/unless}}

</body>
</html>
